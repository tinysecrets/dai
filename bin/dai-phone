#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
S22="${DAI_S22_ADDR:-100.104.165.28:41063}"
usage(){ echo "Usage: dai-phone <command>"; echo "       dai-phone --test"; echo "       dai-phone --status"; }
[[ "${1:-}" == "--status" ]] && { adb connect "$S22" >/dev/null 2>&1 || true; adb devices | grep -F "$S22" || true; exit 0; }
if [[ "${1:-}" == "--test" ]]; then set -- "echo DAI_PHONE_BRIDGE_OK"; fi
INPUT="$*"
[[ -n "$INPUT" ]] || { usage; exit 2; }
adb connect "$S22" >/dev/null
if ! adb -s "$S22" shell pm path com.dhakidd.phoneagent >/dev/null 2>&1; then echo "Phone Agent APK not installed" >&2; exit 1; fi
adb -s "$S22" shell pm enable com.dhakidd.phoneagent >/dev/null 2>&1 || true
REMOTE_INPUT=$(printf %q "$INPUT"); adb -s "$S22" shell "am start -n com.dhakidd.phoneagent/.MainActivity -a android.intent.action.SEND -t text/plain --es android.intent.extra.TEXT $REMOTE_INPUT" >/dev/null
echo "SENT TO S22: $INPUT"
